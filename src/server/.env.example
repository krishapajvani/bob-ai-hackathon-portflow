# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local MongoDB (default for development)
MONGODB_URI=mongodb://localhost:27017/portflow

# MongoDB Atlas example (replace with your cluster URL for cloud deployment)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portflow

# ── AI provider ───────────────────────────────────────────────────────────────
# "watsonx" - use IBM watsonx.ai (requires credentials below)
# "rules"   - deterministic fallback only (no LLM calls — safe for demo)
AI_PROVIDER=rules

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Required only when AI_PROVIDER=watsonx

# IBM Cloud API key — generate at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key_here

# watsonx.ai project ID — find in your watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai regional endpoint
# Options: https://us-south.ml.cloud.ibm.com
#          https://eu-gb.ml.cloud.ibm.com
#          https://au-syd.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID — configurable, do not hardcode
# Recommended: ibm/granite-13b-chat-v2
# Alternative: ibm/granite-20b-multilingual
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── OpenAI (not used in Phase 4 — reserved for future) ───────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
